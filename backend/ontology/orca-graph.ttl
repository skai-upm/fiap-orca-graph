@prefix orca: <https://orca-graph.example/ontology/> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .

orca:inValueChain a owl:ObjectProperty ;
    rdfs:label "pertenece al espacio de la cadena"@es , "belongs to value-chain workspace"@en ;
    rdfs:comment "Asigna una entidad al contexto de una cadena activa sin convertir la cadena en un nodo del grafo de trabajo."@es ;
    rdfs:range orca:ValueChain .

orca: a owl:Ontology ;
    rdfs:label "ORCA Graph ontology"@en ;
    rdfs:label "Ontología de ORCA Graph"@es ;
    rdfs:comment """
        An ontology for the collaborative authoring of scopes, hierarchical
        components and key performance indicators.
    """@en ;
    rdfs:comment """
        Ontología para la creación colaborativa de ámbitos, componentes
        jerárquicos e indicadores clave de rendimiento.
    """@es .

#################################################################
# Classes and class restrictions
#################################################################

orca:Scope a owl:Class ;
    rdfs:label "Scope"@en ;
    rdfs:label "Ámbito"@es ;
    rdfs:comment """
        A thematic area that groups zero or more components. Scopes are not
        arranged hierarchically and do not relate directly to KPIs.
    """@en ;
    rdfs:comment """
        Área temática que agrupa cero o más componentes. Los ámbitos no se
        organizan jerárquicamente ni se relacionan directamente con los KPI.
    """@es ;

    # Every scope has exactly one name.
    rdfs:subClassOf [
        a owl:Restriction ;
        owl:onProperty orca:name ;
        owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
        owl:onDataRange xsd:string
    ] ;

    # Every scope has exactly one description.
    rdfs:subClassOf [
        a owl:Restriction ;
        owl:onProperty orca:description ;
        owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
        owl:onDataRange xsd:string
    ] ;

    # A scope may group zero or more components.
    rdfs:subClassOf [
        a owl:Restriction ;
        owl:onProperty orca:hasComponent ;
        owl:allValuesFrom orca:Component
    ] ;

    # A scope can only be similar to another scope.
    rdfs:subClassOf [
        a owl:Restriction ;
        owl:onProperty orca:similarTo ;
        owl:allValuesFrom orca:Scope
    ] ;

    owl:disjointWith orca:Component,
        orca:KPI .

orca:Component a owl:Class ;
    rdfs:label "Component"@en ;
    rdfs:label "Componente"@es ;
    rdfs:comment """
        A thematic component grouped by a scope. Components can be arranged
        hierarchically: a subcomponent is another instance of orca:Component.
        KPIs relate to components rather than directly to scopes.
    """@en ;
    rdfs:comment """
        Componente temático agrupado por un ámbito. Los componentes pueden
        organizarse jerárquicamente: un subcomponente es otra instancia de
        orca:Component. Los KPI se relacionan con componentes y no directamente
        con ámbitos.
    """@es ;

    # Every component has exactly one name.
    rdfs:subClassOf [
        a owl:Restriction ;
        owl:onProperty orca:name ;
        owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
        owl:onDataRange xsd:string
    ] ;

    # Every component has exactly one description.
    rdfs:subClassOf [
        a owl:Restriction ;
        owl:onProperty orca:description ;
        owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
        owl:onDataRange xsd:string
    ] ;

    # All subcomponent values must be components.
    rdfs:subClassOf [
        a owl:Restriction ;
        owl:onProperty orca:hasSubcomponent ;
        owl:allValuesFrom orca:Component
    ] ;

    # All supercomponent values must be components.
    rdfs:subClassOf [
        a owl:Restriction ;
        owl:onProperty orca:hasSupercomponent ;
        owl:allValuesFrom orca:Component
    ] ;

    # A component can only contain KPIs.
    rdfs:subClassOf [
        a owl:Restriction ;
        owl:onProperty orca:hasKPI ;
        owl:allValuesFrom orca:KPI
    ] ;

    owl:disjointWith orca:KPI .

orca:KPI a owl:Class ;
    rdfs:label "Key performance indicator"@en ;
    rdfs:label "Indicador clave de rendimiento"@es ;
    rdfs:comment """
        A key performance indicator used to evaluate performance against
        a defined objective.
    """@en ;
    rdfs:comment """
        Indicador clave de rendimiento utilizado para evaluar el desempeño
        respecto de un objetivo definido.
    """@es ;

    # Every KPI has exactly one name.
    rdfs:subClassOf [
        a owl:Restriction ;
        owl:onProperty orca:name ;
        owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
        owl:onDataRange xsd:string
    ] ;

    # Every KPI has exactly one identification.
    rdfs:subClassOf [
        a owl:Restriction ;
        owl:onProperty orca:identification ;
        owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
        owl:onDataRange xsd:string
    ] ;

    # Every KPI has exactly one description.
    rdfs:subClassOf [
        a owl:Restriction ;
        owl:onProperty orca:description ;
        owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
        owl:onDataRange xsd:string
    ] ;

    # Every KPI has exactly one evaluation.
    rdfs:subClassOf [
        a owl:Restriction ;
        owl:onProperty orca:evaluation ;
        owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
        owl:onDataRange xsd:string
    ] ;

    # A KPI can apply directly to any kind of agent.
    rdfs:subClassOf [
        a owl:Restriction ;
        owl:onProperty orca:appliesToAgent ;
        owl:allValuesFrom orca:Agent
    ] ;

    # A KPI can apply directly to components.
    rdfs:subClassOf [
        a owl:Restriction ;
        owl:onProperty orca:appliesToComponent ;
        owl:allValuesFrom orca:Component
    ] ;

    # A KPI can only be similar to another KPI.
    rdfs:subClassOf [
        a owl:Restriction ;
        owl:onProperty orca:similarTo ;
        owl:allValuesFrom orca:KPI
    ] .

orca:Agent a owl:Class ;
    rdfs:label "Agent"@en ;
    rdfs:label "Agente"@es ;
    rdfs:comment """
        An actor that participates in one or more links of a value chain.
    """@en ;
    rdfs:comment """
        Actor que participa en uno o varios eslabones de una cadena de valor.
    """@es ;
    owl:disjointUnionOf (
        orca:PrincipalAgent
        orca:AuxiliaryAgent
        orca:SupportAgent
    ) .

orca:PrincipalAgent a owl:Class ;
    rdfs:subClassOf orca:Agent ;
    rdfs:label "Principal agent"@en ;
    rdfs:label "Agente principal"@es ;
    rdfs:comment """
        An agent whose main activity belongs to one or more value-chain links.
        KPIs apply directly to the agent.
    """@en ;
    rdfs:comment """
        Agente cuya actividad principal pertenece a uno o más eslabones de la
        cadena de valor. Los KPI se aplican directamente al agente.
    """@es ;
    rdfs:subClassOf [
        a owl:Restriction ;
        owl:onProperty orca:participatesInValueChainLink ;
        owl:someValuesFrom orca:ValueChainLink
    ] ;
    rdfs:subClassOf [
        a owl:Restriction ;
        owl:onProperty orca:participatesInValueChainLink ;
        owl:allValuesFrom orca:ValueChainLink
    ] .

orca:AuxiliaryAgent a owl:Class ;
    rdfs:subClassOf orca:Agent ;
    rdfs:label "Auxiliary agent"@en ;
    rdfs:label "Agente auxiliar"@es ;
    rdfs:comment """
        An agent that participates in a value-chain link in an auxiliary
        capacity. A KPI applies directly to this agent rather than to the link.
    """@en ;
    rdfs:comment """
        Agente que participa en un eslabón de la cadena de valor con una
        función auxiliar. El KPI se aplica directamente a este agente y no
        al eslabón.
    """@es ;
    rdfs:subClassOf [
        a owl:Restriction ;
        owl:onProperty orca:participatesInValueChainLink ;
        owl:someValuesFrom orca:ValueChainLink
    ] ;
    rdfs:subClassOf [
        a owl:Restriction ;
        owl:onProperty orca:participatesInValueChainLink ;
        owl:allValuesFrom orca:ValueChainLink
    ] .

orca:SupportAgent a owl:Class ;
    rdfs:subClassOf orca:Agent ;
    rdfs:label "Support agent"@en ;
    rdfs:label "Agente de apoyo"@es ;
    rdfs:comment """
        An agent that supports a value-chain link. A KPI applies directly to
        this agent rather than to the link.
    """@en ;
    rdfs:comment """
        Agente que presta apoyo a un eslabón de la cadena de valor. El KPI se
        aplica directamente a este agente y no al eslabón.
    """@es ;
    rdfs:subClassOf [
        a owl:Restriction ;
        owl:onProperty orca:participatesInValueChainLink ;
        owl:someValuesFrom orca:ValueChainLink
    ] ;
    rdfs:subClassOf [
        a owl:Restriction ;
        owl:onProperty orca:participatesInValueChainLink ;
        owl:allValuesFrom orca:ValueChainLink
    ] .

orca:ResearchSupportAgent a owl:Class ;
    rdfs:subClassOf orca:SupportAgent ;
    rdfs:label "Research support agent"@en ;
    rdfs:label "Agente de apoyo a la investigación"@es ;
    rdfs:comment "A support agent whose main activity is research or research support."@en ;
    rdfs:comment "Agente de apoyo cuya actividad principal es la investigación o el apoyo a la investigación."@es .

orca:TrainingSupportAgent a owl:Class ;
    rdfs:subClassOf orca:SupportAgent ;
    rdfs:label "Training support agent"@en ;
    rdfs:label "Agente de apoyo formativo"@es ;
    rdfs:comment "A support agent that provides education, training or capacity building."@en ;
    rdfs:comment "Agente de apoyo que proporciona educación, formación o desarrollo de capacidades."@es .

orca:GovernmentSupportAgent a owl:Class ;
    rdfs:subClassOf orca:SupportAgent ;
    rdfs:label "Government support agent"@en ;
    rdfs:label "Agente de apoyo gubernamental"@es ;
    rdfs:comment "A support agent that belongs to a public administration."@en ;
    rdfs:comment "Agente de apoyo perteneciente a una administración pública."@es .

orca:NationalGovernmentSupportAgent a owl:Class ;
    rdfs:subClassOf orca:GovernmentSupportAgent ;
    rdfs:label "National government support agent"@en ;
    rdfs:label "Agente de apoyo gubernamental nacional"@es ;
    rdfs:comment "A government support agent operating at national level."@en ;
    rdfs:comment "Agente de apoyo gubernamental que opera en el nivel nacional."@es .

orca:RegionalGovernmentSupportAgent a owl:Class ;
    rdfs:subClassOf orca:GovernmentSupportAgent ;
    rdfs:label "Regional government support agent"@en ;
    rdfs:label "Agente de apoyo gubernamental regional"@es ;
    rdfs:comment "A government support agent operating at regional level."@en ;
    rdfs:comment "Agente de apoyo gubernamental que opera en el nivel regional."@es .

orca:LocalGovernmentSupportAgent a owl:Class ;
    rdfs:subClassOf orca:GovernmentSupportAgent ;
    rdfs:label "Local government support agent"@en ;
    rdfs:label "Agente de apoyo gubernamental local"@es ;
    rdfs:comment "A government support agent operating at local level."@en ;
    rdfs:comment "Agente de apoyo gubernamental que opera en el nivel local."@es .

[
    a owl:AllDisjointClasses ;
    owl:members (
        orca:ResearchSupportAgent
        orca:TrainingSupportAgent
        orca:GovernmentSupportAgent
    )
] .

[
    a owl:AllDisjointClasses ;
    owl:members (
        orca:NationalGovernmentSupportAgent
        orca:RegionalGovernmentSupportAgent
    )
] .

orca:ValueChain a owl:Class ;
    rdfs:label "Value chain"@en ;
    rdfs:label "Cadena de valor"@es ;
    rdfs:comment """
        An ordered or structured set of links through which value is created.
    """@en ;
    rdfs:comment """
        Conjunto ordenado o estructurado de eslabones mediante los que se
        genera valor.
    """@es ;
    rdfs:subClassOf [
        a owl:Restriction ;
        owl:onProperty orca:hasValueChainLink ;
        owl:someValuesFrom orca:ValueChainLink
    ] ;
    rdfs:subClassOf [
        a owl:Restriction ;
        owl:onProperty orca:hasValueChainLink ;
        owl:allValuesFrom orca:ValueChainLink
    ] .

orca:ValueChainLink a owl:Class ;
    rdfs:label "Value-chain link"@en ;
    rdfs:label "Eslabón de la cadena de valor"@es ;
    rdfs:comment """
        A stage, activity or link that forms part of a value chain.
    """@en ;
    rdfs:comment """
        Etapa, actividad o eslabón que forma parte de una cadena de valor.
    """@es ;
    rdfs:subClassOf [
        a owl:Restriction ;
        owl:onProperty orca:isValueChainLinkOf ;
        owl:someValuesFrom orca:ValueChain
    ] ;
    rdfs:subClassOf [
        a owl:Restriction ;
        owl:onProperty orca:isValueChainLinkOf ;
        owl:allValuesFrom orca:ValueChain
    ] ;
    rdfs:subClassOf [
        a owl:Restriction ;
        owl:onProperty orca:isValueChainLinkOf ;
        owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
        owl:onClass orca:ValueChain
    ] ;
    rdfs:subClassOf [
        a owl:Restriction ;
        owl:onProperty orca:isRelated ;
        owl:allValuesFrom orca:ValueChainLink
    ] .

#################################################################
# Object properties
#################################################################

orca:hasComponent a owl:ObjectProperty ;
    rdfs:label "has component"@en ;
    rdfs:label "tiene componente"@es ;
    rdfs:comment """
        Relates a scope to one of the components that it groups.
    """@en ;
    rdfs:comment """
        Relaciona un ámbito con uno de los componentes que agrupa.
    """@es ;
    rdfs:domain orca:Scope ;
    rdfs:range orca:Component ;
    owl:inverseOf orca:isComponentOf .

orca:isComponentOf a owl:ObjectProperty ;
    rdfs:label "is component of"@en ;
    rdfs:label "es componente de"@es ;
    rdfs:comment """
        Relates a component to a scope that groups it.
    """@en ;
    rdfs:comment """
        Relaciona un componente con un ámbito que lo agrupa.
    """@es ;
    rdfs:domain orca:Component ;
    rdfs:range orca:Scope ;
    owl:inverseOf orca:hasComponent .

orca:hasSubcomponent a owl:ObjectProperty ;
    rdfs:label "has subcomponent"@en ;
    rdfs:label "tiene subcomponente"@es ;
    rdfs:comment "Relates a component to one of its direct subcomponents."@en ;
    rdfs:comment "Relaciona un componente con uno de sus subcomponentes directos."@es ;
    rdfs:domain orca:Component ;
    rdfs:range orca:Component ;
    owl:inverseOf orca:hasSupercomponent .

orca:hasSupercomponent a owl:ObjectProperty ;
    rdfs:label "has supercomponent"@en ;
    rdfs:label "tiene supercomponente"@es ;
    rdfs:comment "Relates a component to one of its direct parent components."@en ;
    rdfs:comment "Relaciona un componente con uno de sus componentes superiores directos."@es ;
    rdfs:domain orca:Component ;
    rdfs:range orca:Component ;
    owl:inverseOf orca:hasSubcomponent .

orca:hasValueChainLink a owl:ObjectProperty ;
    rdfs:label "has value-chain link"@en ;
    rdfs:label "tiene eslabón de cadena de valor"@es ;
    rdfs:comment "Relates a value chain to one of its constituent links."@en ;
    rdfs:comment """
        Relaciona una cadena de valor con uno de sus eslabones.
    """@es ;
    rdfs:domain orca:ValueChain ;
    rdfs:range orca:ValueChainLink ;
    owl:inverseOf orca:isValueChainLinkOf .

orca:isValueChainLinkOf a owl:ObjectProperty ;
    rdfs:label "is value-chain link of"@en ;
    rdfs:label "es eslabón de la cadena de valor"@es ;
    rdfs:comment "Relates a value-chain link to its value chain."@en ;
    rdfs:comment """
        Relaciona un eslabón de cadena de valor con la cadena a la que
        pertenece.
    """@es ;
    rdfs:domain orca:ValueChainLink ;
    rdfs:range orca:ValueChain ;
    owl:inverseOf orca:hasValueChainLink .

orca:belongsTo a owl:ObjectProperty ;
    rdfs:label "belongs to"@en ;
    rdfs:label "pertenece"@es ;
    rdfs:comment """
        Relates a principal agent to the value-chain link to which its main
        activity belongs.
    """@en ;
    rdfs:comment """
        Relaciona un agente principal con el eslabón de la cadena de valor
        al que pertenece su actividad principal.
    """@es ;
    rdfs:domain orca:PrincipalAgent ;
    rdfs:range orca:ValueChainLink ;
    owl:inverseOf orca:hasPrincipalAgent .

orca:hasPrincipalAgent a owl:ObjectProperty ;
    rdfs:label "has principal agent"@en ;
    rdfs:label "tiene agente principal"@es ;
    rdfs:comment """
        Relates a value-chain link to one of its principal agents.
    """@en ;
    rdfs:comment """
        Relaciona un eslabón de la cadena de valor con uno de sus agentes
        principales.
    """@es ;
    rdfs:domain orca:ValueChainLink ;
    rdfs:range orca:PrincipalAgent ;
    owl:inverseOf orca:belongsTo .

orca:participatesInValueChainLink a owl:ObjectProperty ;
    rdfs:label "participates in value-chain link"@en ;
    rdfs:label "participa en el eslabón de la cadena de valor"@es ;
    rdfs:comment """
        Relates any agent to a value-chain link in which it participates.
    """@en ;
    rdfs:comment """
        Relaciona cualquier agente con un eslabón de la cadena de valor en el
        que participa.
    """@es ;
    rdfs:domain orca:Agent ;
    rdfs:range orca:ValueChainLink ;
    owl:inverseOf orca:hasParticipatingAgent .

orca:hasParticipatingAgent a owl:ObjectProperty ;
    rdfs:label "has participating agent"@en ;
    rdfs:label "tiene agente participante"@es ;
    rdfs:comment """
        Relates a value-chain link to any participating agent.
    """@en ;
    rdfs:comment """
        Relaciona un eslabón de la cadena de valor con cualquier agente que
        participa en él.
    """@es ;
    rdfs:domain orca:ValueChainLink ;
    rdfs:range orca:Agent ;
    owl:inverseOf orca:participatesInValueChainLink .

orca:appliesToAgent a owl:ObjectProperty ;
    rdfs:label "applies to agent"@en ;
    rdfs:label "se aplica al agente"@es ;
    rdfs:comment """
        Relates a KPI directly to an agent, regardless of whether the agent is
        principal, auxiliary or support.
    """@en ;
    rdfs:comment """
        Relaciona un KPI directamente con un agente, con independencia de que
        sea principal, auxiliar o de apoyo.
    """@es ;
    rdfs:domain orca:KPI ;
    rdfs:range orca:Agent ;
    owl:inverseOf orca:hasAssociatedKPI .

orca:hasAssociatedKPI a owl:ObjectProperty ;
    rdfs:label "has associated KPI"@en ;
    rdfs:label "tiene KPI asociado"@es ;
    rdfs:comment """
        Relates an agent of any type to a KPI associated with that agent.
    """@en ;
    rdfs:comment """
        Relaciona un agente de cualquier tipo con un KPI asociado a dicho
        agente.
    """@es ;
    rdfs:domain orca:Agent ;
    rdfs:range orca:KPI ;
    owl:inverseOf orca:appliesToAgent .

orca:appliesToComponent a owl:ObjectProperty ;
    rdfs:label "applies to component"@en ;
    rdfs:label "se aplica al componente"@es ;
    rdfs:comment "Relates a KPI directly to the component to which it applies."@en ;
    rdfs:comment "Relaciona un KPI directamente con el componente al que se aplica."@es ;
    rdfs:domain orca:KPI ;
    rdfs:range orca:Component ;
    owl:inverseOf orca:hasKPI .

orca:hasKPI a owl:ObjectProperty ;
    rdfs:label "has KPI"@en ;
    rdfs:label "tiene KPI"@es ;
    rdfs:comment "Relates a component to a KPI that applies to it."@en ;
    rdfs:comment "Relaciona un componente con un KPI que se aplica a él."@es ;
    rdfs:domain orca:Component ;
    rdfs:range orca:KPI ;
    owl:inverseOf orca:appliesToComponent .

orca:isRelated a owl:ObjectProperty,
        owl:SymmetricProperty ;
    rdfs:label "is related"@en ;
    rdfs:label "está relacionado con"@es ;
    rdfs:comment "Relación general entre dos eslabones de la cadena de valor."@es ;
    rdfs:domain orca:ValueChainLink ;
    rdfs:range orca:ValueChainLink .

orca:muevePescadoFresco a owl:ObjectProperty ;
    rdfs:subPropertyOf orca:isRelated ;
    rdfs:label "Pescado fresco"@es ;
    rdfs:domain orca:ValueChainLink ;
    rdfs:range orca:ValueChainLink .

orca:muevePescadoSeco a owl:ObjectProperty ;
    rdfs:subPropertyOf orca:isRelated ;
    rdfs:label "Pescado seco"@es ;
    rdfs:domain orca:ValueChainLink ;
    rdfs:range orca:ValueChainLink .

orca:mueveHarinaDePescado a owl:ObjectProperty ;
    rdfs:subPropertyOf orca:isRelated ;
    rdfs:label "Harina de pescado"@es ;
    rdfs:domain orca:ValueChainLink ;
    rdfs:range orca:ValueChainLink .

orca:financiación a owl:ObjectProperty ;
    rdfs:subPropertyOf orca:isRelated ;
    rdfs:label "Transfers funding"@en ;
    rdfs:label "Financiación"@es ;
    rdfs:domain orca:ValueChainLink ;
    rdfs:range orca:ValueChainLink .

orca:similarTo a owl:ObjectProperty,
        owl:SymmetricProperty ;
    rdfs:label "similar to"@en ;
    rdfs:label "similar a"@es ;
    rdfs:comment """
        Relates two scopes or two KPIs that are considered semantically
        similar. The relation is symmetric but not transitive.
    """@en ;
    rdfs:comment """
        Relaciona dos ámbitos o dos KPI que se consideran semánticamente
        similares. La relación es simétrica, pero no transitiva.
    """@es ;
    rdfs:domain [
        a owl:Class ;
        owl:unionOf (
            orca:Scope
            orca:KPI
        )
    ] ;
    rdfs:range [
        a owl:Class ;
        owl:unionOf (
            orca:Scope
            orca:KPI
        )
    ] .

#################################################################
# Datatype properties
#################################################################

orca:name a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "name"@en ;
    rdfs:label "nombre"@es ;
    rdfs:comment "The name of a scope, component or KPI."@en ;
    rdfs:comment "Nombre de un ámbito, componente o KPI."@es ;
    rdfs:domain [
        a owl:Class ;
        owl:unionOf (
            orca:Scope
            orca:Component
            orca:KPI
            orca:Agent
            orca:ValueChain
            orca:ValueChainLink
        )
    ] ;
    rdfs:range xsd:string .

orca:description a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "description"@en ;
    rdfs:label "descripción"@es ;
    rdfs:comment """
        A textual description of a scope, component, KPI, agent, value chain
        or value-chain link.
    """@en ;
    rdfs:comment """
        Descripción textual de un ámbito, componente, KPI, agente, cadena de
        valor o eslabón.
    """@es ;
    rdfs:domain [
        a owl:Class ;
        owl:unionOf (
            orca:Scope
            orca:Component
            orca:KPI
            orca:Agent
            orca:ValueChain
            orca:ValueChainLink
        )
    ] ;
    rdfs:range xsd:string .

orca:identification a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "identification"@en ;
    rdfs:label "identificación"@es ;
    rdfs:comment "The textual identification of a KPI."@en ;
    rdfs:comment "Identificación textual de un KPI."@es ;
    rdfs:domain orca:KPI ;
    rdfs:range xsd:string .

orca:evaluation a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "evaluation"@en ;
    rdfs:label "evaluación"@es ;
    rdfs:comment "The textual evaluation method or criteria of a KPI."@en ;
    rdfs:comment "Método o criterios textuales de evaluación de un KPI."@es ;
    rdfs:domain orca:KPI ;
    rdfs:range xsd:string .

orca:visibleToUsers a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "visible to users"@en ;
    rdfs:label "visible para los usuarios"@es ;
    rdfs:comment "Indicates whether a class is listed for normal users in the Definitions section."@en ;
    rdfs:comment "Indica si una clase se muestra a los usuarios normales en la sección Definiciones."@es ;
    rdfs:domain owl:Class ;
    rdfs:range xsd:boolean .


#################################################################
# Protected core concepts
#################################################################

orca:coreConcept a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "core concept"@en ;
    rdfs:label "concepto estructural"@es ;
    rdfs:comment "Marks ontology classes that are required by the application and cannot be deleted."@en ;
    rdfs:comment "Marca las clases originales de la ontología que necesita la aplicación y que no se pueden borrar."@es ;
    rdfs:domain owl:Class ;
    rdfs:range xsd:boolean .

orca:Scope orca:coreConcept true .
orca:Component orca:coreConcept true .
orca:KPI orca:coreConcept true .
orca:Agent orca:coreConcept true .
orca:PrincipalAgent orca:coreConcept true .
orca:AuxiliaryAgent orca:coreConcept true .
orca:SupportAgent orca:coreConcept true .
orca:ResearchSupportAgent orca:coreConcept true .
orca:TrainingSupportAgent orca:coreConcept true .
orca:GovernmentSupportAgent orca:coreConcept true .
orca:NationalGovernmentSupportAgent orca:coreConcept true .
orca:RegionalGovernmentSupportAgent orca:coreConcept true .
orca:LocalGovernmentSupportAgent orca:coreConcept true .
orca:ValueChain orca:coreConcept true .
orca:ValueChainLink orca:coreConcept true .
